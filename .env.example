# Copy to .env and adjust
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
# Embedded Qdrant (no Docker needed, lightest for a laptop). Comment it out to use the
# Qdrant server from `make up` at QDRANT_URL instead.
QDRANT_PATH=data/index
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Ollama runs natively on the host (not in Docker) to use the Apple GPU
OLLAMA_BASE_URL=http://localhost:11434
GENERATOR_MODEL=qwen3:4b-instruct
CRITIC_MODEL=qwen3:4b-instruct
JUDGE_MODEL=gemma3:4b

# Tracing: off | console | otlp (otlp → Jaeger from `make traces`, UI on :16686)
TRACING=off
OTLP_ENDPOINT=http://localhost:4318

# Resource limits: ONNX threads per model (0 = all cores), parallel agent retrievals
ONNX_THREADS=2
AGENT_MAX_CONCURRENCY=1
